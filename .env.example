# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017/catalogue
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=catalogue

# PostgreSQL Configuration
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=ecom_password
POSTGRES_DB=ecom_db
DATABASE_URL=postgresql://ecom_user:ecom_password@postgres:5432/ecom_db

# Node.js Services
NODE_ENV=development
CATALOGUE_SERVICE_PORT=5001
USER_SERVICE_PORT=5002

# Python Services
RATINGS_SERVICE_PORT=5003
FLASK_ENV=development

# Frontend
REACT_PORT=3000

# Service URLs (for inter-service communication)
CATALOGUE_SERVICE_URL=http://catalogue:5001
USER_SERVICE_URL=http://user:5002
RATINGS_SERVICE_URL=http://ratings:5003